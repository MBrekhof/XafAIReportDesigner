@page "/designer"
@rendermode InteractiveServer
@inject ReportDataV2Store Store

@if (string.IsNullOrEmpty(Report))
{
    <div class="content">
        <h1>Report Designer</h1>
        @if (_error != null)
        {
            <p class="status">Database unavailable: @_error</p>
        }
        else
        {
            <p>Pick a report:</p>
            <ul>
                @foreach (var name in _reports)
                {
                    <li><a href="/designer?report=@Uri.EscapeDataString(name)">@name</a></li>
                }
            </ul>
        }
    </div>
}
else
{
    <DxReportDesigner ReportName="@Report" Height="calc(100vh - 46px)" Width="100%" AllowMDI="false">
    </DxReportDesigner>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "report")]
    public string? Report { get; set; }

    IReadOnlyList<string> _reports = [];
    string? _error;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Report)) return;
        try { _reports = Store.ListNames(); }
        catch (Exception ex) { _error = ex.Message; }
    }
}
