@page "/designer"
@rendermode InteractiveServer
@inject ReportDataV2Store Store
@inject NavigationManager Nav

@if (string.IsNullOrEmpty(Report))
{
    @* No report named: nothing to design, back to the list (history replaced so Back works). *@
}
else if (_error != null)
{
    <div class="designer-bar"><a href="/">← Reports</a></div>
    <div class="content">
        <p class="error" id="designer-error">@_error</p>
    </div>
}
else
{
    <div class="designer-bar">
        <a href="/">← Reports</a>
        <span class="name" id="designer-name">@Report</span>
    </div>
    <DxReportDesigner ReportName="@Report" Height="calc(100vh - 81px)" Width="100%" AllowMDI="false">
    </DxReportDesigner>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "report")]
    public string? Report { get; set; }

    string? _error;

    protected override void OnParametersSet()
    {
        _error = null;
        if (string.IsNullOrEmpty(Report))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        try
        {
            if (!Store.Exists(Report)) _error = $"Report '{Report}' does not exist.";
        }
        catch (Exception ex)
        {
            _error = "Database unavailable: " + ex.Message;
        }
    }
}
