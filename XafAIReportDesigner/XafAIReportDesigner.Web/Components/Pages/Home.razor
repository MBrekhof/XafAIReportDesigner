@page "/"
@rendermode InteractiveServer
@inject ReportDataV2Store Store
@inject NavigationManager Nav
@implements IDisposable
@using DevExpress.XtraReports.UI
@using XafAIReportDesigner.Web.Components.Shared

<div class="content">
    <h1>Reports</h1>

    @if (_dbError != null)
    {
        <div class="panel">
            <p class="error" id="db-error">Database unavailable: @_dbError</p>
            <DxButton Text="Retry" Click="@Reload" />
        </div>
    }

    <div class="toolbar-row">
        <DxButton Text="+ New report from prompt" RenderStyle="ButtonRenderStyle.Primary" Id="new-report"
                  Enabled="@(!Busy && _dbError == null && !_showNew)" Click="@(() => { _modifyName = null; _showNew = true; })" />
    </div>

    @* The New panel stays mounted (hidden) so prompt and name survive Close/reopen. *@
    <div hidden="@(!_showNew)">
        <AiRunPanel Locked="@Busy" RunningChanged="@OnRunningChanged" OnClosed="@(refresh => ClosePanel(refresh))" />
    </div>
    @if (!_showNew && _modifyName != null)
    {
        @* @key: picking another report must give a fresh panel, not re-parameterise the old one *@
        <AiRunPanel @key="@_modifyName" ReportName="@_modifyName" Locked="@Busy" RunningChanged="@OnRunningChanged" OnClosed="@(refresh => ClosePanel(refresh))" />
    }

    <DxGrid Data="@_rows" ShowSearchBox="true" KeyFieldName="Name" PageSize="20" CssClass="reports-grid" id="reports-grid">
        <Columns>
            <DxGridDataColumn FieldName="Name" Caption="Report">
                <CellDisplayTemplate>
                    @{ var row = (ReportRow)context.DataItem; }
                    <span>@row.Name</span>
                    @if (row.IsPredefined) { <span class="badge lock" title="Predefined XAF report — read-only here">🔒</span> }
                    else if (row.IsAi == true) { <span class="badge ai" title="Generated by the AI pipeline">AI</span> }
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="Name" Caption=" " Width="290px" AllowSort="false" SearchEnabled="false" ShowInColumnChooser="false">
                <CellDisplayTemplate>
                    @{ var row = (ReportRow)context.DataItem; }
                    <div class="actions">
                        <DxButton Text="Open" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!Busy)"
                                  Click="@(() => Nav.NavigateTo($"/designer?report={Uri.EscapeDataString(row.Name)}"))" />
                        @if (!row.IsPredefined)
                        {
                            <DxButton Text="Modify" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!Busy && row.IsAi == true)"
                                      Click="@(() => { _showNew = false; _modifyName = row.Name; })" />
                            <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline"
                                      Enabled="@(!Busy)" Click="@(() => _deleteName = row.Name)" />
                        }
                    </div>
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </Columns>
    </DxGrid>

    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="status" id="list-status">@_status</p>
    }
</div>

<DxPopup @bind-Visible="@DeleteVisible" HeaderText="Delete report" ShowFooter="true" Width="420px">
    <BodyContentTemplate>
        Delete "@_deleteName"? This cannot be undone.
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger" Id="confirm-delete" Click="@ConfirmDelete" />
        <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _deleteName = null)" />
    </FooterContentTemplate>
</DxPopup>

@code {
    sealed class ReportRow
    {
        public string Name { get; init; } = "";
        public bool IsPredefined { get; init; }
        public bool? IsAi { get; set; } // null until the badge pass has looked at the layout
    }

    List<ReportRow> _rows = [];
    string? _dbError;
    string _status = "";
    bool _showNew;
    string? _modifyName;
    string? _deleteName;
    bool _running;
    int _loadGeneration;

    bool Busy => _running;
    bool DeleteVisible { get => _deleteName != null; set { if (!value) _deleteName = null; } }

    protected override void OnInitialized() => Reload();

    void Reload()
    {
        _dbError = null;
        _loadGeneration++; // invalidates any badge pass still running, success or not
        try
        {
            _rows = Store.List().Select(r => new ReportRow { Name = r.Name, IsPredefined = r.IsPredefined }).ToList();
        }
        catch (Exception ex)
        {
            _rows = [];
            _dbError = ex.Message;
            return;
        }
        _ = FillBadgesAsync(_loadGeneration);
    }

    // Names render immediately; the badge needs the layout, so it arrives afterwards (RPT-010).
    async Task FillBadgesAsync(int generation)
    {
        foreach (var row in _rows.ToList())
        {
            if (row.IsPredefined) continue;
            bool isAi = false;
            try
            {
                isAi = await Task.Run(() =>
                {
                    if (Store.Load(row.Name) is not { Length: > 0 } bytes) return false;
                    using var report = new XtraReport();
                    using var ms = new MemoryStream(bytes);
                    report.LoadLayoutFromXml(ms);
                    return ReportSpecTranslator.TryGetSpec(report) != null;
                });
            }
            catch { /* unreadable layout → no badge */ }
            if (generation != _loadGeneration) return; // a newer reload superseded this pass
            row.IsAi = isAi;
            await InvokeAsync(StateHasChanged);
        }
    }

    Task OnRunningChanged(bool running)
    {
        _running = running;
        return Task.CompletedTask;
    }

    void ClosePanel(bool refresh)
    {
        _showNew = false;
        _modifyName = null;
        if (refresh) Reload();
    }

    public void Dispose() => _loadGeneration++; // stop the badge pass once the page is gone

    void ConfirmDelete()
    {
        var name = _deleteName;
        _deleteName = null;
        if (name == null) return;
        try
        {
            _status = Store.Delete(name) ? $"'{name}' deleted." : $"'{name}' was not deleted (predefined or already gone).";
            Reload();
        }
        catch (Exception ex)
        {
            _status = "Delete failed: " + ex.Message;
        }
    }
}
